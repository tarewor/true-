    height: 100%;
    overflow-y: auto;
  }

  /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
  .appEmbed[data-current-step='form']::-webkit-scrollbar {
    /* Hide scrollbar */
    display: none; /* Safari and Chrome */
  }
}
