    opacity: 0;
  }

  100% {
    opacity: 1;
  }
}

._container_3eyaa_70 {
  position: relative;
  z-index: 2;
  min-width: minmax(335px, 100%);
  animation-timing-function: ease;
  animation-duration: 0.8s;
}

/* breakpoint sm */
@media screen and (max-width: 490px) {
