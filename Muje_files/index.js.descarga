  font-weight: 600;
  color: var(--forms-discount-code-color);
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
}

._copyIcon_bboux_35 {
  margin-left: 10px;
}

._copyIcon_bboux_35 path {
  fill: var(--forms-discount-code-color);
}
