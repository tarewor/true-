button._copyToClipboardButton_bboux_2 {
  all: unset;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  margin: 0 0 8px;
  padding: 8px 16px;
  border-radius: 8px;
  background-color: rgba(0, 0, 0, 0);
  transition: filter 0.3s, background-color 0.3s;
  max-width: 100%;
}

button._copyToClipboardButton_bboux_2:hover {
  background-color: var(--forms-discount-code-background-color-hover);
}

button._copyToClipboardButton_bboux_2:active {
  background-color: var(--forms-discount-code-background-color-hover);
  filter: brightness(90%);
}

span._copyToClipboardText_bboux_24 {
  font-size: 22px;
  line-height: 1.19;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--forms-discount-code-color);
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
}

._copyIcon_bboux_35 {
  margin-left: 10px;
}

._copyIcon_bboux_35 path {
  fill: var(--forms-discount-code-color);
}
