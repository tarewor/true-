@keyframes _blur_1q1d2_1 {
  from {
    filter: blur(8px);
  }

  to {
    filter: blur(0);
  }
}

:root {
  --form-container-background-image: none;
  --min-form-width: 335px;
}

@media screen and (min-width: 893px) {
  .isPreview.isPreview--withImage {
    --preview-scale: 1.9;
  }
}

._formContainer_1q1d2_30 {
  --col-size: 320px;
  position: relative;
  margin: 2px; /* Prevents short forms clipping */
  min-width: var(--min-form-width);
  box-shadow: var(--container-shadow);
  border-radius: var(--container-border-radius);
  background-color: var(--container-background-color);
  max-height: 100%;
  overflow-y: auto;
  overflow: hidden;
}

.isPreview ._formContainer_1q1d2_30 {
  box-shadow: 0 0 5px rgba(0, 0, 0, 0.05), 0 1px 2px rgba(0, 0, 0, 0.15);
}

.isPreview._inline_1q1d2_47 ._formContainer_1q1d2_30 {
  box-shadow: none;
}

/* Checkered background is set for inline form behind transparent background */
.isPreview:not(._floating_1q1d2_52) ._formContainer_1q1d2_30::before {
  content: '';
  position: absolute;
  z-index: -1;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: var(--container-border-radius);
  background: repeating-conic-gradient(
      var(--p-color-bg-surface) 0% 25%,
      var(--p-color-bg-surface-secondary) 0% 50%
    )
    50% / var(--p-space-400) var(--p-space-400);
}

/* Custom media query to match when preview breaks into 1 column */
@media screen and (min-width: 893px) {
  .isPreview.isPreview--withImage ._formContainer_1q1d2_30 {
    --col-size: 195.5px;
  }
}

._formContainerImage_1q1d2_75 {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Inline */
._inline_1q1d2_47 {
  display: grid;
  justify-items: var(--inline-form-alignment);
  align-content: center;
  height: 100%;
  width: 100%;
  background-color: var(--container-background-color);
  overflow: hidden;
}

._inline_1q1d2_47 ._formContainer_1q1d2_30 {
  min-width: unset;
  max-width: var(--inline-container-max-width);
  width: 100%;
  min-height: var(--inline-container-min-height);
}

/* Overlay */
._overlay_1q1d2_100 {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

@keyframes _overlay-background-fade-in_1q1d2_1 {
  0% {
    opacity: 0;
    visibility: hidden;
  }

  100% {
    opacity: var(--forms-overlay-background-opacity);
    visibility: visible;
  }
}

._overlay_1q1d2_100 ._overlayBackground_1q1d2_123,
._overlay_1q1d2_100 ._overlayBackground_1q1d2_123:empty {
  position: absolute;
  display: block;
