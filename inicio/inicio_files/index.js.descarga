}

@media screen and (max-width: 768px) {
  :not(.isPreview)._floating_1q1d2_52 {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
}

:not(.isPreview)._floating_1q1d2_52 ._grid_1q1d2_148,
._overlay_1q1d2_100 ._grid_1q1d2_148 {
  max-height: 90vh;
  overflow-y: auto;
}

/* Grid */
._grid_1q1d2_148 {
  display: grid;
  grid-template-columns: repeat(2, var(--col-size));
  max-width: calc(2 * var(--col-size));
}

._noImage_1q1d2_161 {
  display: block;
  max-width: var(--container-max-w);
}

._background_1q1d2_166 {
  grid-template-columns: minmax(var(--min-form-width), var(--container-max-w));
  max-width: var(--container-max-w);
  min-width: var(--min-form-width);
}

._background_1q1d2_166 ._gridItem_1q1d2_172:nth-child(1) {
